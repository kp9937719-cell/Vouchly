# =============================================
# Proofly — Environment Configuration Example
# Copy this file to .env and fill in your values.
# Never commit the real .env file to version control.
# =============================================

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-to-a-long-random-secret-key

# --- MongoDB ---
# Local MongoDB example:
MONGO_URI=mongodb://localhost:27017/
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=proofly

# --- JWT Secrets ---
# Generate strong random secrets: python -c "import secrets; print(secrets.token_hex(32))"
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# --- Cookies ---
COOKIE_SECURE=False        # Set True in production (HTTPS only)
COOKIE_SAMESITE=Lax

# --- File Uploads ---
UPLOAD_FOLDER=static/uploads
MAX_UPLOAD_SIZE_MB=5

# --- Application URL (used in embed widget generation) ---
APP_BASE_URL=http://localhost:5000

# --- Rate Limiting ---
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_AUTH=10 per minute

# --- Email Configuration ---
# OPTION 1: Real email delivery via SMTP (e.g. Gmail, Outlook, SendGrid)
# To use Gmail: generate an App Password in your Google Account security settings
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_USE_TLS=True
# MAIL_DEFAULT_SENDER=your-email@gmail.com

# OPTION 2: Development email simulation
# When DEV_EMAIL_SIMULATE=True, email content and verification links are printed
# directly to the console terminal and displayed on screen.
DEV_EMAIL_SIMULATE=True
